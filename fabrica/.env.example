# Copia este archivo como .env (en esta misma carpeta) y llena las llaves.
# El .env nunca se sube al repo ni se pega en chats.

# ElevenLabs: Profile -> API keys. La voz: en Voices, el id de "Diego - Bold and Vibrant".
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opcional: modelo de voz (por defecto eleven_multilingual_v2).
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Anthropic (Claude), para el guionista: console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# Opcional: modelo y esfuerzo del guionista (por defecto claude-opus-5-5, esfuerzo low).
# FABRICA_MODELO=claude-opus-5-5
# FABRICA_ESFUERZO=low

# Telegram: el mismo bot y el mismo grupo de moderación (valores iguales a los del
# .env de la API). La fábrica manda los videos al tema TELEGRAM_TOPIC_FABRICA;
# para crearlo: node scripts/fabrica/tema.mjs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_FABRICA=
# Secreto compartido con la API (FABRICA_TOKEN en su .env, el mismo valor): con él
# la fábrica lee las decisiones que el bot recibe. 24+ caracteres.
FABRICA_TOKEN=
# FABRICA_API=https://api.duck-i.app
